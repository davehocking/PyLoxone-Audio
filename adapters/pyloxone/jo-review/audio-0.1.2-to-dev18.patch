+            f'<span class="uuid">[{_esc(state["uuid"])}]</span>'
+            + '<span class="value {cls}">{text}</span></li>'.format(
+                cls=_esc(_value_class(value := self.states.get(state["uuid"]))),
+                text=_esc(_value_text(value)),
