# Keep complete integration previews out of Python source distributions.
prune preview-build
prune checks
prune adapters
prune tools
prune tests/adapter
prune tests/frontend
include API.md
include NOTICE.md
include LICENSE
include README.md
prune tests/release
recursive-include tests/library *.py *.ini *.json *.txt *.md
include DIAGNOSTICS.md
include KNOWN-ISSUES.md
include CHANGELOG.md

include RELEASE-NOTES-0.1.6.md
include USER-GUIDE.md
include DIAGNOSTICS-REFERENCE.md
include AUTOMATION-GROUPING.md
