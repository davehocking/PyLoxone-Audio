+        self.states: dict[str, object] = {}
+
+    def set_structure(self, structure: dict) -> None:
+        self.labels = _state_labels(structure)
+        self.sections = [
+            {"name": "controls", "nodes": _tree_nodes(structure.get("controls") or {}, self.labels)}
+        ]
+        if structure.get("autopilot"):
